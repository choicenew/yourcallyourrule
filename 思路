    <!DOCTYPE html>
    <html>
    <body>
      <h1>Shadow Hijack Test</h1>
      <div id="host"></div>
      <script>
        // 模拟 Cloudflare 的行为：创建一个 closed 模式的 shadow root
        // 常规方法在外部绝对无法获取这个 root
        const host = document.getElementById('host');
        const shadow = host.attachShadow({ mode: 'closed' }); 
        
        // 在里面放一个秘密元素
        const secret = document.createElement('div');
        secret.id = 'target_checkbox';
        secret.innerHTML = '❌ 未被点击';
        secret.style.color = 'red';
        secret.style.fontSize = '24px';
