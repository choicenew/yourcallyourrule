        inputs.forEach(input => {
           // 往往 input 是隐藏的，我们要找它的兄弟元素或者父元素的 shadow
           // 这里仅作兜底
        });
        
        // C. 成功检测
        // 如果页面里出现了成功的标志，比如 cf-turnstile-response 有了值，或者页面发生了跳转
        // ListSpam 的特征：如果成功，通常会刷新或显示号码
        // 我们检查 URL 是否含有 successMarker 指示的内容，或者通过外部注入的检测逻辑
      }

