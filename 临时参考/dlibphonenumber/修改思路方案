import 'dart:io';

// This script migrates data from the original Dart source files to JSON assets.
// It is designed to be run once to perform the data format conversion.

// The one and only correct data source.
const sourceDir = 'dlib/lib/generated/geocoding/';
// The one and only correct destination for migrated assets.
const destinationDir = 'dlib/assets/geocoding/';

void main() async {
  final source = Directory(sourceDir);
  if (!source.existsSync()) {
    print('❌ CRITICAL: Source directory not found at $sourceDir.');
    exit(1);
  }

  final destination = Directory(destinationDir);
  if (!destination.existsSync()) {
    print('Destination directory $destinationDir not found, creating it...');
    await destination.create(recursive: true);
  }

  print('🏁 Starting migration...');
  print('   Source:      $sourceDir');
  print('   Destination: $destinationDir');

  final files = source.listSync().whereType<File>().where((f) => f.path.endsWith('.dart'));

  // This regex is designed to be robust. It captures the entire map literal,
  // including nested structures, by matching curly braces.
  final mapContentRegex = RegExp(r'const Map<int, String> data = ({[\s\S]*?});', multiLine: true);

  // This regex is for parsing individual key-value pairs from the captured string.
  // It correctly handles escaped single quotes within the string values.
  final pairRegex = RegExp(r"(\\d+)\\s*:\\s*'((?:[^']|\\\\')*)'");

  int successCount = 0;
  int failCount = 0;

  for (final file in files) {
    final filename = file.uri.pathSegments.last;
    final jsonFilename = filename.replaceFirst('.dart', '.json');
    final destinationPath = '$destinationDir/$jsonFilename';

    try {
      final content = await file.readAsString();
      final match = mapContentRegex.firstMatch(content);

      if (match == null) {
        print('🟡 WARN: No data map found in $filename. Skipping.');
        continue;
      }

      final mapString = match.group(1)!;

      // --- Step 2: Parse and Build In-Memory Map ---
      final Map<String, String> inMemoryMap = {};
      final allPairs = pairRegex.allMatches(mapString);

      for (final pairMatch in allPairs) {
        final key = pairMatch.group(1)!;
        // Un-escape the value string before putting it in the map.
        final value = pairMatch.group(2)!.replaceAll("\\\\'", "'");
        inMemoryMap[key] = value;
      }

      // --- Step 3: Serialize to JSON using the standard library ---
      final jsonString = JsonEncoder.withIndent('  ').convert(inMemoryMap);

      // --- Step 4: Write to file ---
      await File(destinationPath).writeAsString(jsonString);
      print('✅ Migrated $filename -> $jsonFilename');
      successCount++;

    } catch (e, s) {
      print('❌ ERROR: Failed to process $filename: $e');
      print(s);
      failCount++;
    }
  }

  print('\\n' + ('-' * 20));
  print('🎉 Migration Complete!');
  print('   Successful: $successCount');
  print('   Failed:     $failCount');
  print(('-' * 20));
}
