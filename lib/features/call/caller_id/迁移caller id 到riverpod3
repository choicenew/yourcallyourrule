extension CallerIdConfigX on CallerIdConfig {
  Map<String, dynamic> toMap() => toJson();
  
  // 【关键修改点 1】: fromProviders 的参数类型修正
  // 参数不再是 Notifier 实例，而是它们所管理的【状态】对象。
  static CallerIdConfig fromProviders(CallerIdStyle styleState, SecurityMessageState securityState) {
    return CallerIdConfig(
      // 直接从状态对象中读取属性
