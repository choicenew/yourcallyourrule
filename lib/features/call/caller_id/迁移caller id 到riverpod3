      securityMessageTextColor: securityState.textColor,
      securityMessageFontSize: securityState.fontSize,
      // ... (对所有 securityState 的属性重复此模式)
    );
  }

  // 【关键修改点 2】: applyToProviders 的参数类型修正
  // 参数现在是新的、由代码生成器定义的 Notifier 类型。
  void applyToProviders(CallerIdStyleNotifier styleNotifier, SecurityMessageNotifier securityNotifier) {
    // 调用 Notifier 上的方法来更新状态
    styleNotifier
      ..setBackgroundColorStart(backgroundColorStart)
      ..setBackgroundColorEnd(backgroundColorEnd)
      ..setTextNameColor(textNameColor);
      // ... (对所有 styleNotifier 的方法重复此模式)

    securityNotifier
      ..setTextColor(securityMessageTextColor)
      ..setFontSize(securityMessageFontSize)
      ..updatePosition(securityMessagePosition);
      // ... (对所有 securityNotifier 的方法重复此模式)
  }
}
