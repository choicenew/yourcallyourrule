import 'dart:typed_data';
import 'package:flutter/services.dart' show rootBundle;
import 'package:yourcallyourrule/core/entities/caller_id_data.dart';
import '../notification_config.dart';

class NotificationPayloadBuilder {
  static Future<Map<String, dynamic>> build(NotificationConfig config, CallerIdData data) async {
    
    Future<Uint8List> _getAssetBytes(String path) async {
      try {
        final byteData = await rootBundle.load(path);
        return byteData.buffer.asUint8List();
      } catch (e) {
        return Uint8List(0); // Return empty list on error
      }
    }
    
    // We only need one asset for this example
    final avatarBytes = await _getAssetBytes('assets/avatars/Unknown.png'); // Use a placeholder

    return {
      'backgroundColor': config.backgroundColor.value,

      'avatarImage': avatarBytes,
      'avatarX': config.avatarPosition.dx,
      'avatarY': config.avatarPosition.dy,
      'avatarSize': config.avatarSize,

      'nameText': data.name ?? 'Unknown Caller',
      'nameX': config.namePosition.dx,
      'nameY': config.namePosition.dy,
      'nameColor': config.textNameColor.value,
      'nameFontSize': config.nameFontSize,

      'numberText': data.phoneNumber.value,
      'numberX': config.numberPosition.dx,
      'numberY': config.numberPosition.dy,
      'numberColor': config.textNumberColor.value,
      'numberFontSize': config.numberFontSize,

      // ... map all other fields from NotificationConfig
    };
  }
}