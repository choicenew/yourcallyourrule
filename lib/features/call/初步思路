// The StateNotifier for the UI
class NotificationConfigNotifier extends StateNotifier<AsyncValue<NotificationConfig>> {
  final NotificationConfigService _service;

  NotificationConfigNotifier(this._service) : super(const AsyncValue.loading()) {
    _load();
  }

  Future<void> _load() async {
    try {
      final config = await _service.loadConfig();
      state = AsyncValue.data(config);
    } catch (e, st) {
      state = AsyncValue.error(e, st);
    }
  }

  Future<void> _updateState(NotificationConfig newConfig) async {
    state = AsyncValue.data(newConfig);
    await _service.saveConfig(newConfig);
  }

  void updateWith(NotificationConfig newConfig) {
    _updateState(newConfig);
  }

  void updatePosition(String element, Offset newPosition) {
    state.whenData((config) {
      // Using freezed copyWith
      switch(element) {
        case 'avatar': _updateState(config.copyWith(avatarPosition: newPosition)); break;
        case 'name': _updateState(config.copyWith(namePosition: newPosition)); break;
        // ... add cases for all other elements
      }
    });
  }
  
  // Add more methods for updating colors, font sizes etc.
  void updateColor(String element, Color newColor) {
    state.whenData((config) {
       switch(element) {
        case 'name': _updateState(config.copyWith(textNameColor: newColor)); break;
        // ...
      }
    });
  }
}

// The final provider for the UI
final notificationConfigProvider = StateNotifierProvider<NotificationConfigNotifier, AsyncValue<NotificationConfig>>((ref) {
  final service = ref.watch(notificationConfigServiceProvider);
  return NotificationConfigNotifier(service);
});
