  final String _configKey = 'config_notification_style';

  NotificationConfigService(this._repo);

  Future<NotificationConfig> loadConfig() async {
    final map = await _repo.getConfig(_configKey);
    if (map != null) {
      return NotificationConfig.fromJson(map);
    }
    // Return default if nothing is saved
    return const NotificationConfig();
  }

  Future<void> saveConfig(NotificationConfig config) {
    return _repo.saveConfig(_configKey, config.toJson());
  }
}

