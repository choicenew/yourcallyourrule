// 文件: worker/index.js

export default {
  async fetch(request, env, ctx) {
    // ... (Security checks)

    const url = new URL(request.url);

    // --- [修改] 路由逻辑 ---
    if (url.pathname === '/sync') {
      // 增量同步端点
      // ... (handlePush and handlePull remain the same)
    } else if (url.pathname === '/country-data' && request.method === 'GET') {
      // 🟢 [新增] 全量国家数据端点
      return await handleCountryDataRequest(request, env);
    }

    return errorResponse('Not Found', 404);
  },
};

// ... (handlePush and handlePull functions remain the same) ...

// 🟢 [新增] 处理全量国家数据请求的函数
async function handleCountryDataRequest(request, env) {
  const url = new URL(request.url);
  const countryCode = url.searchParams.get('countryCode');

  if (!countryCode) {
    return errorResponse('Missing "countryCode" query parameter.', 400);
  }

  // 直接查询主数据表，使用 LIKE 前缀匹配
  // 因为 phoneNumber 字段有索引，这个查询是高效的
  const stmt = env.DB.prepare(
    'SELECT * FROM remote_numbers WHERE phoneNumber LIKE ?'
  ).bind(`${countryCode}%`);

  const { results } = await stmt.all();

  return jsonResponse({ numbers: results });
}
总结：是的，你的想法完全正确

这个新的架构：

创建了一个独立的 CountryDataService，专门负责处理与“下载/删除国家数据”相关的业务逻辑。

IncrementalSyncManager 的职责变得更加纯粹：它现在只关心为那些已经存在于本地的国家拉取增量更新。

用户流程与代码结构完美匹配:

用户在 CountrySelectionWidget 中点击“下载”。

UI 调用 CountryDataService.downloadCountryData()。

CountryDataService 通过新的 /country-data API 从 Worker 拉取全量数据，存入本地数据库，并将该国家注册到 CountrySelectionService 中。

之后，IncrementalSyncManager 在后台运行时，会从 CountrySelectionService 看到这个新注册的国家，并在调用 /sync API 时自动为它拉取增量更新。

这是一个更加成熟、可扩展和逻辑清晰的系统。你的这个提议，将整个架构的质量提升到了一个新的水平。






是的，你说得完全正确。
采用我们刚刚讨论的这个最终优化方案，你的客户端数据库（RemoteDatabaseManagerImpl.dart）完全不需要做任何修改。
让我来为你详细解释为什么，并确认这一点。
为什么客户端数据库无需修改？
表结构已经足够:
remote_numbers: 这个表用来存储你从服务器下载的所有号码数据。无论你下载的是一个国家还是十个国家的数据，它们都可以存放在这张表里。它的结构（id, phoneNumber 等）已经能够满足存储需求。
pending_operations: 这个表用来记录你在本地做的所有修改。它的结构（entityId, operation, payload）也与你要上传的数据格式完全匹配。
sync_records: 这个表用来记录每一次同步操作的历史，它的结构也已经能够满足记录需求。
sync_config: 这个表用来存储全局配置，如 lastSyncTime，也已经就位。
“按国家过滤”的逻辑发生在更高层次:
最关键的一点是，我们决定不在数据库层面强制进行数据隔离（比如为每个国家创建不同的表）。
相反，我们把“用户选择了哪些国家”这个信息，存储在了 ConfigRepository 中（通过 CountrySelectionService）。
因此，决定要下载哪个国家的数据，或者要更新哪个国家的数据，这个决策逻辑发生在 CountryDataService 和 IncrementalSyncManager 这两个服务层。
数据库本身是“无知”的，它只是一个被动的存储容器。服务层告诉它“存这些数据”，它就存；服务层告诉它“把这些数据给我”，它就给。它不需要知道这些数据属于哪个国家。
索引已经能满足性能需求:
你之前已经决定在 remote_numbers 的 phoneNumber 字段上创建索引。
因为所有号码都是 E.164 格式，所以这个索引对于在服务器端执行 WHERE phoneNumber LIKE '+86%' 来筛选特定国家的全量数据是高效的。
对于客户端，由于本地只存储了用户选择的少量国家的数据，所以本地数据库本身就很小，任何查询（无论是否使用索引）都会非常快。
回顾整个流程，确认数据库无变动
下载中国数据:
CountryDataService 被调用。
它通过 ApiService 请求 GET /country-data?countryCode=+86。
服务器返回一个号码列表。
CountryDataService 调用 RemoteNumberDataSource.insertAll(numbers)。
RemoteNumberDataSource 忠实地将这个号码列表插入到现有的 remote_numbers 表中。
数据库: 表结构没变，只是里面多了很多 +86 开头的数据。
增量同步:
IncrementalSyncManager 启动。
它从 CountrySelectionService 知道用户关心 +86 的数据。
它命令 ApiService 去获取 +86 的增量变更。
服务器返回一个操作日志列表。
IncrementalSyncManager 调用 RemoteNumberDataSource.applyRemoteChanges(changes)。
RemoteNumberDataSource 根据日志，在现有的 remote_numbers 表中执行 INSERT, UPDATE, DELETE 等操作。
数据库: 表结构没变，只是里面的数据根据日志被更新了。
结论:
你之前的 RemoteDatabaseManagerImpl.dart 文件，只要确保它包含了 remote_numbers, pending_operations, sync_records, sync_config 这四张表的创建逻辑，并且为 remote_numbers(phoneNumber) 创建了索引，那么它就是最终的、完美的状态，完全不需要再做任何修改。



























