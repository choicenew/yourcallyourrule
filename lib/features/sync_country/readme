// 文件: lib/features/sync_country/services/country_data_service.dart

import 'package:your_app_name/core/services/api_service.dart';
import 'package:your_app_name/data/datasources/remote/remote_number_datasource.dart';
import 'package:your_app_name/features/sync_country/services/country_selection_service.dart';

/// This service is responsible for the one-time action of downloading
/// the full dataset for a specific country.
class CountryDataService {
  final ApiService _apiService;
  final RemoteNumberDataSource _dataSource;
  final CountrySelectionService _selectionService;

  const CountryDataService(this._apiService, this._dataSource, this._selectionService);

  /// Downloads all numbers for a given country code and saves them to the local DB.
  /// It also registers the country as "selected" for future incremental syncs.
  Future<void> downloadCountryData(String countryDialCode) async {
    try {
      // 1. Fetch the full list of numbers for the country from the new API endpoint.
      final numbers = await _apiService.getInitialDataForCountry(countryDialCode);

      if (numbers.isNotEmpty) {
        // 2. Use the DataSource to save this data in bulk.
        //    (You might need to add an `insertAll` method to your DataSource if it doesn't exist)
        await _dataSource.insertAll(numbers); 
      }

      // 3. After a successful download, add this country to the list of
      //    countries that need to be incrementally synced in the future.
      await _selectionService.addCountry(countryDialCode);
      
    } catch (e) {
      // Handle or re-throw the error
      print('Failed to download data for country $countryDialCode: $e');
      throw;
    }
  }
  
  // You could also add a `removeCountryData` method here if needed.
  Future<void> removeCountryData(String countryDialCode) async {
      // ... logic to delete local data and unregister from sync ...
      await _dataSource.deleteNumbersByCountryCode(countryDialCode); // (requires new DataSource method)
      await _selectionService.removeCountry(countryDialCode);
  }
}
第二步：修改 ApiService.dart (增加新方法)
