// 文件: lib/logic/incremental_sync_manager.dart

class IncrementalSyncManager {
  // ... (dependencies remain, but it now also needs CountrySelectionService)
  late CountrySelectionService _countrySelectionService;

  Future<void> initialize() async {
    // ...
    _countrySelectionService = CountrySelectionService(_configRepository);
    // ...
  }

  Future<bool> _performSync() async {
    try {
      // ... (Push logic remains the same) ...

      // --- [核心修改] ---
      // 1. 获取需要“更新”的国家列表
      final selectedCountryCodes = await _countrySelectionService.getSelectedCountryDialCodes();

      // 2. 如果没有国家需要更新，则跳过拉取
      if (selectedCountryCodes.isEmpty) {
        // ... record sync and return ...
        return true;
      }
      
      // 3. 拉取这些国家的“增量”变更
      final lastSyncTime = await _dataSource.getLastSyncTime();
      final deviceId = await _deviceIdService.getDeviceId();

      final remoteChanges = await _apiService.getChanges(
        since: lastSyncTime,
        deviceId: deviceId,
        countryCodes: selectedCountryCodes,
      );

      // ... (Apply changes logic remains the same) ...
    } catch (e) {
      // ...
    }
    return false;
  }
  // ...
}
