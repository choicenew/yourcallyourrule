// ...
class RemoteNumberDataSource {
  // ...
  Future<void> bulkInsertFromServer(List<Map<String, dynamic>> numbers, String countryCode) async {
    final db = await _databaseManager.database;
    await db.transaction((txn) async {
      final batch = txn.batch();
      for (final numberMap in numbers) {
        // 插入或更新主表
        batch.insert('remote_numbers', numberMap, conflictAlgorithm: ConflictAlgorithm.replace);
        // 插入关联表
        batch.insert('number_countries', {
          'phoneNumber': numberMap['phoneNumber'],
          'countryCode': countryCode,
        }, conflictAlgorithm: ConflictAlgorithm.ignore); // Ignore if association already exists
      }
      await batch.commit(noResult: true);
    });
  }

  Future<int> deleteNumbersByCountryCode(String countryCode) async {
    final db = await _databaseManager.database;
    // 1. 找出这个国家独有的号码 (不再被其他已选国家引用的号码)
    // 这需要一条复杂的 SQL 查询，或者分步查询
    // (简化逻辑：先删除关联，再删除孤立号码)
    
    // a. 删除关联
    int deletedCount = await db.delete('number_countries', where: 'countryCode = ?', whereArgs: [countryCode]);
    
    // b. 删除不再被任何国家关联的号码
    await db.rawDelete('''
      DELETE FROM remote_numbers
      WHERE phoneNumber NOT IN (SELECT DISTINCT phoneNumber FROM number_countries)
    ''');
    
    return deletedCount;
  }
}
