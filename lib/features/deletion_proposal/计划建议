// new file: proposal_limit_config_service.dart
import 'package:yourcallyourrule/data/repositories/config/config_repository.dart';
import 'api_service.dart';
import 'config_sync_scheduler.dart';

class ProposalLimitConfigService {
    final ApiService _apiService;
    final ConfigRepository _configRepository;
    final ConfigSyncScheduler _scheduler;

    static const _configKey = 'proposalLimits';

    ProposalLimitConfigService({
        required ApiService apiService,
        required ConfigRepository configRepository,
        required ConfigSyncScheduler scheduler,
    }) : _apiService = apiService,
         _configRepository = configRepository,
         _scheduler = scheduler;
    
    /// Fetches config from the server if needed and saves it locally.
    /// This should be called periodically, e.g., on app start.
    Future<void> syncConfigIfNeeded() async {
        if (await _scheduler.needsSync) {
            try {
                final remoteConfig = await _apiService.getProposalLimitsConfig();
                await _configRepository.saveConfig(_configKey, remoteConfig);
                await _scheduler.recordSync();
                print('Proposal limits config synced successfully.');
            } catch (e) {
                print('Failed to sync proposal limits config: $e');
                // Optionally handle error, but don't block the app.
            }
        }
    }

    /// Gets the config from the local cache.
    Future<Map<String, dynamic>> getLimits() async {
        final localConfig = await _configRepository.getConfig(_configKey);
        // Return local config or a hardcoded default if nothing is cached.
        return localConfig ?? {
            'vipLimit': 3,
            'standardLimit': 1,
            'votesPerProposal': 10,
            'checkIntervalDays': 7,
        };
    }
}

具体的操作步骤
整个流程分为两步：1. 创建表并插入初始数据，2. 编写更新数据的脚本（可选但推荐）。
第一步：在 Cloudflare D1 中初始化 app_config 表
这是一次性的操作，你需要在部署 worker.js 之前或之后，通过 Cloudflare 的仪表盘或者使用 wrangler 命令行工具来完成。
使用 wrangler 命令行 (推荐，可重复执行)
在你的项目根目录下，创建一个 SQL 文件，例如 schema-config.sql：
code
SQL
-- File: schema-config.sql

-- 先删除旧表，确保脚本可以重复运行而不会出错
DROP TABLE IF EXISTS app_config;

-- 创建 app_config 表
CREATE TABLE app_config (
    config_key TEXT PRIMARY KEY, -- 'proposalLimits', 'featureFlags', etc.
    config_value TEXT NOT NULL,  -- JSON string
    last_updated TEXT NOT NULL   -- ISO 8601 timestamp, for delta sync
);

-- 插入初始的、默认的配置数据
-- 确保 JSON 字符串是有效的，并且没有多余的换行符
INSERT INTO app_config (config_key, config_value, last_updated) VALUES
('proposalLimits', '{"vipLimit":3,"standardLimit":1,"votesPerProposal":10,"checkIntervalDays":7}', '2023-01-01T00:00:00Z');
注意：我将 JSON 压缩成了一行，以避免 SQL 解析问题。
使用 wrangler 执行这个 SQL 文件：
code
Bash
# <YOUR_DATABASE_NAME> 是你在 wrangler.toml 中定义的 D1 数据库的名称
npx wrangler d1 execute <YOUR_DATABASE_NAME> --file=./schema-config.sql
执行这条命令后，你的 D1 数据库中就会有 app_config 表，并且里面已经有了一条 proposalLimits 的记录。你的 Worker 代码现在就可以正常查询到它了。
使用 Cloudflare 仪表盘 (手动操作)
登录 Cloudflare 仪表盘。
进入 Workers & Pages -> D1。
选择你的数据库。
在控制台（Console）标签页中，粘贴上面的 SQL CREATE TABLE ... 和 INSERT INTO ... 语句，然后点击执行。
第二步：如何更新这个配置？
当你需要修改 vipLimit 从 3 变成 5 时，你也需要手动去更新数据库里的这条记录。
使用 wrangler 命令行更新
你可以直接在命令行中执行一条 UPDATE 语句。
code
Bash
# 更新 vipLimit 到 5，并更新时间戳以触发客户端同步
npx wrangler d1 execute <YOUR_DATABASE_NAME> --command="UPDATE app_config SET config_value = '{\"vipLimit\":5,\"standardLimit\":1,\"votesPerProposal\":10,\"checkIntervalDays\":7}', last_updated = '$(date -u +"%Y-%m-%dT%H:%M:%SZ")' WHERE config_key = 'proposalLimits';"
这里的 $(date ...) 是一个 shell 命令，会自动生成当前的 UTC 时间。
使用 Cloudflare 仪表盘更新
在 D1 数据库的控制台中执行 UPDATE 语句：
code
SQL
UPDATE app_config
SET
  config_value = '{"vipLimit":5,"standardLimit":1,"votesPerProposal":10,"checkIntervalDays":7}',
  last_updated = '2024-05-21T10:00:00Z' -- 手动输入一个比上次新的时间
WHERE config_key = 'proposalLimits';
总结
谁来处理？ -> 你（开发者/管理员） 需要在 Cloudflare D1 数据库中处理这个表的创建和数据维护。
在哪里处理？ -> 通过 wrangler 命令行工具 或者 Cloudflare 网站的 D1 仪表盘。
Worker 的角色是什么？ -> Worker 是一个只读的消费者。它只是从这个你维护好的表中读取数据，然后提供给 App。
这个模式非常清晰：后端数据管理（你通过 wrangler/UI 操作） 和 后端数据服务（Worker 提供 API） 是分离的。这给了你完全的控制权，可以安全地修改配置，而不需要去改动或重新部署 Worker 的代码。