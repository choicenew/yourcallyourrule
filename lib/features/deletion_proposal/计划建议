// new file: proposal limit  config_sync_scheduler.dart
import 'package:shared_preferences/shared_preferences.dart';

class proposal limit  ConfigSyncScheduler {
    final SharedPreferences _prefs;
    final Duration _syncInterval;
    static const _lastSyncKey = 'config_last_sync_time';

    ConfigSyncScheduler({
        required SharedPreferences prefs,
        Duration? syncInterval,
    }) : _prefs = prefs,
         _syncInterval = syncInterval ?? const Duration(hours: 1); // e.g., check config every hour

    Future<bool> get needsSync async {
        final lastSyncString = _prefs.getString(_lastSyncKey);
        if (lastSyncString == null) {
            return true; // Never synced
        }
        final lastSyncTime = DateTime.parse(lastSyncString);
        return DateTime.now().difference(lastSyncTime) >= _syncInterval;
    }

    Future<void> recordSync() async {
        await _prefs.setString(_lastSyncKey, DateTime.now().toIso8601String());
    }
}
