// 数据库表结构
class AllowedEntry {
  String? avatar;
  String? label;
  String phoneNumber;
  String? name;

  AllowedEntry({
    this.avatar,
     this.label,
    required this.phoneNumber,
    this.name,
  });

  Map<String, dynamic> toJson() => {
        'avatar': avatar,
        'label': label,
        'phoneNumber': phoneNumber,
        'name': name,
      };

  static AllowedEntry fromJson(Map<String, dynamic> json) => AllowedEntry(
        avatar: json['avatar'],
        label: json['label'],
        phoneNumber: json['phoneNumber'],
        name: json['name'],
      );
}

class BlockedEntry {
  String? avatar;
  String? label;
  String phoneNumber;
  String? name;

  BlockedEntry({
    this.avatar,
    this.label,
    required this.phoneNumber,
    this.name,
  });

  Map<String, dynamic> toJson() => {
        'avatar': avatar,
        'label': label,
        'phoneNumber': phoneNumber,
        'name': name,
      };

  static BlockedEntry fromJson(Map<String, dynamic> json) => BlockedEntry(
        avatar: json['avatar'],
        label: json['label'],
        phoneNumber: json['phoneNumber'],
        name: json['name'],
      );
}

// 数据访问服务
class AllowedService {
  final Database database;

  AllowedService(this.database);

  // 添加allowed名单条目
  /*Future<void> add(AllowedEntry entry) async {
    final exists = await database.query('allowed_phonenumber',
        where: 'phoneNumber = ?',
        whereArgs: [entry.phoneNumber]).then((results) => results.isNotEmpty);
    if (!exists) {
      await database.insert('allowed_phonenumber', entry.toJson());
    }
  }*/
Future<void> add(AllowedEntry entry) async {
  await database.insert('allowed_phonenumber', entry.toJson(),
      conflictAlgorithm: ConflictAlgorithm.ignore);
}
  // 批量添加allowed名单条目
  Future<void> addAll(List<AllowedEntry> entries) async {
    final batch = database.batch();
    for (final entry in entries) {
      batch.insert('allowed_phonenumber', entry.toJson());
    }
    await batch.commit();
  }

  //根据号码查询allowed名单的标签
  // Get all labels from the allowed database
  Future<List<String>> getAllAllowedLabels() async {
//final database = await _initDatabase();
    final labels = await database.query('allowed_phonenumber').then(
        (results) => results.map((row) => row['label'] as String).toList());

    // Return unique labels
    return labels.toSet().toList();
  }
  Future<void> insertPredefinedLabelsIfNotExists(Database database) async {
  // 获取数据库中已存在的标签
  final existingLabels = await database
      .query('allowed_phonenumber', columns: ['label'])
      .then((results) => results.map((row) => row['label'] as String).toSet());

  // 创建一个批处理操作
  final batch = database.batch();

  // 遍历预定义标签，插入不存在的标签
  for (final labelMap in predefinedLabels) {
    final label = labelMap['label'] as String;
    if (!existingLabels.contains(label)) {
      batch.insert('allowed_phonenumber', {
        'label': label,
        'phoneNumber': '', // 使用空字符串作为占位符

      });
    }
  }

  // 执行批处理操作
  await batch.commit();
}


//根据号码查询标签
  Future<String?> getLabelByPhoneNumber(String phoneNumber) async {
    // 1. 解析电话号码
    PhoneNumber parsedNumber;
    try {
      parsedNumber = await PhoneNumberUtil.instance.parse(phoneNumber, null);
    } catch (NumberParseException) {
      // 解析号码失败，则无法匹配标签
      return null;
    }

    // 2. 格式化为 E.164 格式和本地格式的号码
    final e164Number =
        PhoneNumberUtil.instance.format(parsedNumber, PhoneNumberFormat.e164);
    final nationalNumber = PhoneNumberUtil.instance
        .format(parsedNumber, PhoneNumberFormat.national);
    final List<Map<String, dynamic>> results = await database.query(
        'allowed_phonenumber',
        where: 'phoneNumber IN (?, ?)',
        whereArgs: [e164Number, nationalNumber]);

    // 4. 如果找到匹配的标签，则返回该标签
    if (results.isNotEmpty) {
      // 取出第一个匹配的结果
      final String label = results.first['label'];
      return label;
    } else {
      // 未找到匹配的标签
      return null;
    }
  }

  // 检查号码是否在允许名单中
  Future<bool> isAllowed(String phoneNumber) async {
    final allowedEntry = await database.query('allowed_phonenumber',
        where: 'phoneNumber = ?',
        whereArgs: [
          phoneNumber
        ]).then((results) =>
        results.isNotEmpty ? AllowedEntry.fromJson(results.first) : null);
    return allowedEntry != null;
  }

// 修改allowed单中号码的姓名和标签
  Future<void> editAllowedEntry(AllowedEntry entry) async {
//final database = await _initDatabase();
    await database.update('allowed_phonenumber', entry.toJson(),
        where: 'phoneNumber = ?', whereArgs: [entry.phoneNumber]);
  }

  Future<void> remove(AllowedEntry entry) async {
    database.delete('allowed_phonenumber',
        where: 'phoneNumber = ?', whereArgs: [entry.phoneNumber]);
  }

  Future<bool> contains(String phoneNumber) {
    return database.query('allowed_phonenumber',
        where: 'phoneNumber = ?',
        whereArgs: [phoneNumber]).then((results) => results.isNotEmpty);
  }

  Future<List<AllowedEntry>> getEntries() {
    return database.query('allowed_phonenumber').then(
        (results) => results.map((row) => AllowedEntry.fromJson(row)).toList());
  }

  Future<AllowedEntry?> getEntryByPhoneNumber(String phoneNumber) {
    return database.query('allowed_phonenumber',
        where: 'phoneNumber = ?',
        whereArgs: [
          phoneNumber
        ]).then((results) =>
        results.isNotEmpty ? AllowedEntry.fromJson(results.first) : null);
  }
}

class BlockedService {
  final Database database;

  BlockedService(this.database);

  // 添加blocked名单条目
  Future<void> add(BlockedEntry entry) async {
    final exists = await database.query('blocked_phonenumber',
        where: 'phoneNumber = ?',
        whereArgs: [entry.phoneNumber]).then((results) => results.isNotEmpty);
    if (!exists) {
      await database.insert('blocked_phonenumber', entry.toJson());
    }
  }

  // 批量添加blocked名单条目
  Future<void> addAll(List<BlockedEntry> entries) async {
    final batch = database.batch();
    for (final entry in entries) {
      batch.insert('blocked_phonenumber', entry.toJson());
    }
    await batch.commit();
  }

  //根据号码查询allowed名单的标签
  // Get all labels from the blockwed database
  Future<List<String>> getAllBlockedLabels() async {
//final database = await _initDatabase();
    final labels = await database.query('blocked_phonenumber').then(
        (results) => results.map((row) => row['label'] as String).toList());

    // Return unique labels
    return labels.toSet().toList();
  }

  Future<void> insertPredefinedLabelsIfNotExists(Database database) async {
  // 获取数据库中已存在的标签
  final existingLabels = await database
      .query('blocked_phonenumber', columns: ['label'])
      .then((results) => results.map((row) => row['label'] as String).toSet());

  // 创建一个批处理操作
  final batch = database.batch();

  // 遍历预定义标签，插入不存在的标签
  for (final labelMap in predefinedLabels) {
    final label = labelMap['label'] as String;
    if (!existingLabels.contains(label)) {
      batch.insert('blocked_phonenumber', {
        'label': label,
        'phoneNumber': '', // 使用空字符串作为占位符

      });
    }
  }

  // 执行批处理操作
  await batch.commit();
}


