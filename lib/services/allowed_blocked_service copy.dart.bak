Database? _database;
Future<Database> get database async {
  if (_database != null) return _database!;

  _database = await _initDatabase();
  return _database!;
}

Future<Database> _initDatabase() async {
  final String path = join(await getDatabasesPath(), 'call_rule_database.db');

  return await openDatabase(
    path,
    version: 1,
    onCreate: createDatabase,
  );
}
/*
Future<Database> openDatabase() async {
  final _databaseName = "allowed_blocked.db";
  final _databaseVersion = 1;
  return await sqflite.openDatabase(_databaseName, version: _databaseVersion, onCreate: createDatabase);
}
*/

Future<void> createDatabase(
    Database database, int version) async {
  if (version == 1) {
    await database.execute('''
      CREATE TABLE IF NOT EXISTS allowed_phonenumber (
        avatar TEXT,
        label TEXT,
        phoneNumber TEXT NOT NULL UNIQUE,
        name TEXT NOT NULL
      )
    ''');

    await database.execute('''
      CREATE TABLE IF NOT EXISTS blocked_phonenumber (
        avatar TEXT,
        label TEXT,
        phoneNumber TEXT NOT NULL UNIQUE,
        name TEXT NOT NULL
      )
    ''');
  }
}

