class RemoteNumberDataSource {
  final RemoteDatabaseManager _databaseManager;
  static const String _tableName = 'remote_numbers';
  static const String _proposalInfoTable = 'active_deletion_proposals';
  static const String _pendingOperationsTable = 'pending_operations';

  RemoteNumberDataSource(this._databaseManager);

  Future<void> applyRemoteChanges(List<Map<String, dynamic>> changes) async {
    final db = await _databaseManager.database;
    final batch = db.batch();
    for (final change in changes) {
      final op = change['operation'];
      final id = change['entityId'] as String?;
      if (id == null) continue;
      switch (op) {
        case 'UPDATE':
          final p = change['payload'];
          if (p is Map<String, dynamic>) batch.insert(_tableName, p, conflictAlgorithm: ConflictAlgorithm.replace);
          break;
        case 'DELETE':
          batch.delete(_tableName, where: 'phoneNumber = ?', whereArgs: [id]);
          batch.delete(_proposalInfoTable, where: 'phoneNumber = ?', whereArgs: [id]);
          break;
        case 'DELETION_PROPOSAL_INFO':
          final p = change['payload'] as Map<String, dynamic>?;
          if (p != null) {
            batch.insert(_proposalInfoTable, {
                'phoneNumber': id, 'proposalCount': p['proposalCount'],
                'highestTrustLevel': p['highestTrustLevel'], 'verifiedOwnerCount': p['verifiedOwnerCount'],
                'currentDeleteRatio': p['currentDeleteRatio'], 'lastUpdated': DateTime.now().toIso8601String(),
                'verificationReportJson': jsonEncode(p['latestVerificationReport']),
              }, conflictAlgorithm: ConflictAlgorithm.replace);
          }
          break;
      }
    }
    await batch.commit(noResult: true);
  }
  
  Future<bool> atomicVote(String phoneNumber, String label) async {
    final db = await _databaseManager.database;
    int result = 0;
    await db.transaction((txn) async {
      final maps = await txn.query(_tableName, where: 'phoneNumber = ?', whereArgs: [phoneNumber]);
      if (maps.isEmpty) return;
      final record = maps.first;
      final count = record['count'] as int? ?? 0;
      final json = record['labels_json'] as String?;
      Map<String, dynamic> labels = json != null ? jsonDecode(json) : {};
      labels[label] = (labels[label] ?? 0) + 1;
      String topLabel = labels.entries.reduce((a, b) => a.value > b.value ? a : b).key;
      result = await txn.update(_tableName, {
          'count': count + 1, 'label': topLabel, 'labels_json': jsonEncode(labels)
        }, where: 'phoneNumber = ?', whereArgs: [phoneNumber]);
      if (result > 0) await _logOperation(txn, 'VOTE', phoneNumber, payload: {'label': label});
    });
    return result > 0;
  }

  Future<void> logCustomOperation({required String op, required String id, required Map<String, dynamic> p}) async {
    final db = await _databaseManager.database;
    await _logOperation(db, op, id, payload: p);
  }

  Future<void> _logOperation(DatabaseExecutor txn, String op, String id, {Map<String, dynamic>? p}) async {
    await txn.insert(_pendingOperationsTable, {
      'id': Uuid().v4(), 'entityId': id, 'operation': op,
      'payload': p != null ? jsonEncode(p) : null, 'timestamp': DateTime.now().toIso8601String(),
    });
  }

  Future<Map<String, dynamic>?> getProposalInfo(String phoneNumber) async {
      final db = await _databaseManager.database;
      final results = await db.query(_proposalInfoTable, where: 'phoneNumber = ?', whereArgs: [phoneNumber], limit: 1);
      if (results.isNotEmpty) {
          final proposal = Map<String, dynamic>.from(results.first);
          if (proposal['verificationReportJson'] != null) {
              proposal['verificationReport'] = jsonDecode(proposal['verificationReportJson']);
          }
          return proposal;
      }
      return null;
  }
  
