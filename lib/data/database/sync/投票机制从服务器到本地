/// (OPTIMAL VERSION - STATE-BASED SYNC)
/// Applies a list of changes fetched from the server.
/// In this model, the client only receives final states ('UPDATE') or
/// deletion commands ('DELETE'), simplifying the logic immensely.
Future<void> applyRemoteChanges(List<Map<String, dynamic>> changes) async {
  final db = await _databaseManager.database;

  // Use a batch for performance
  final batch = db.batch();

  for (final change in changes) {
    final operation = change['operation'];
    final entityId = change['entityId'] as String?; // This is phoneNumber
    
    if (entityId == null) continue;

    switch (operation) {
      // For both new records and existing ones, the server provides the final state.
      // We use `replace` to handle both inserts and updates in one command.
      case 'UPDATE':
        final payload = change['payload'];
        if (payload is Map<String, dynamic>) {
          batch.insert(
            _tableName,
            payload, // The payload is the complete remote_numbers record
            conflictAlgorithm: ConflictAlgorithm.replace,
          );
        }
        break;
      
      // The server commands to delete a record.
      case 'DELETE':
        batch.delete(
          _tableName,
          where: 'phoneNumber = ?',
          whereArgs: [entityId],
        );
        break;
      
      // No other cases are expected from the server in this model.
    }
  }
  
  // Atomically commit all changes to the local database.
  await batch.commit(noResult: true);
}
