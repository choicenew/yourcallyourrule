/**
 * (OPTIMAL VERSION - STATE-BASED SYNC)
 * Handles client requests to pull incremental changes from the server.
 * This version implements a state-based sync model, providing clients with the
 * final, computed state of records rather than raw operation logs. This makes
 * the client logic simpler and more robust.
 * Endpoint: GET /sync?since=...&deviceId=...&countryCodes=...
 */
async function handlePull(request, env) {
  const url = new URL(request.url);
  const since = url.searchParams.get('since');
  const deviceId = url.searchParams.get('deviceId');
  const countryCodesParam = url.searchParams.get('countryCodes');

  if (!since || !deviceId || !countryCodesParam) {
    return errorResponse('Query parameters "since", "deviceId", and "countryCodes" are required.', 400);
  }

  const countryCodes = countryCodesParam.split(',').filter(c => c);
  if (countryCodes.length === 0) {
      return jsonResponse({ operations: [] }); // No countries selected, no operations to return.
  }

  const placeholders = countryCodes.map(() => '?').join(',');

  // --- Step 1: Find all unique phoneNumbers that were affected since the last sync ---
  // This query efficiently gathers all relevant changes, including updates and deletions.
  const affectedNumbersQuery = `
    SELECT DISTINCT op.phoneNumber, op.operation
    FROM op_log AS op
    WHERE
      op.timestamp > ?
      AND op.source_device_id != ?
      AND (
        -- For non-DELETE ops, check if the number belongs to a selected country.
        (op.operation != 'DELETE' AND EXISTS (
          SELECT 1 FROM number_countries nc
          WHERE nc.phoneNumber = op.phoneNumber AND nc.countryIsoCode IN (${placeholders})
        ))
        -- For DELETE ops, check the payload, as the DB record might be gone.
        OR (op.operation = 'DELETE' AND json_extract(op.payload, '$.countryIsoCode') IN (${placeholders}))
      )
  `;
  const bindings = [since, deviceId, ...countryCodes, ...countryCodes];
  const { results: affectedLogs } = await env.DB.prepare(affectedNumbersQuery).bind(...bindings).all();

  if (!affectedLogs || affectedLogs.length === 0) {
    return jsonResponse({ operations: [] });
  }

  // Separate phone numbers for update/insert from those for deletion.
  const numbersToUpdate = new Set();
  const numbersToDelete = new Set();
  for (const log of affectedLogs) {
    // If a number was involved in any non-delete operation, it needs a state update.
    if (log.operation !== 'DELETE') {
      numbersToUpdate.add(log.phoneNumber);
    }
    // If a number was deleted, it should be marked for deletion.
    // We also remove it from the update set to handle cases where a number is updated then deleted.
    if (log.operation === 'DELETE') {
      numbersToDelete.add(log.phoneNumber);
      numbersToUpdate.delete(log.phoneNumber);
    }
  }

  const finalOperations = [];

  // --- Step 2: For numbers that need an update, fetch their CURRENT full state ---
  if (numbersToUpdate.size > 0) {
    const updatePlaceholders = Array.from(numbersToUpdate).map(() => '?').join(',');
    const { results: currentStates } = await env.DB.prepare(
      `SELECT * FROM remote_numbers WHERE phoneNumber IN (${updatePlaceahoolders})`
    ).bind(...numbersToUpdate).all();
    
    for (const state of currentStates) {
      finalOperations.push({
        entityId: state.phoneNumber,
        operation: 'UPDATE', // We send a unified 'UPDATE' command
        payload: state,      // The payload is the complete, final record state
        timestamp: new Date().toISOString() // Timestamp of sync, not original op
      });
    }
  }

  // --- Step 3: For numbers that were deleted, create DELETE operations ---
  for (const phoneNumber of numbersToDelete) {
    finalOperations.push({
      entityId: phoneNumber,
      operation: 'DELETE',
      payload: null, // No payload needed for a delete command
      timestamp: new Date().toISOString()
    });
  }

  // The final list contains definitive state updates and deletions.
  return jsonResponse({ operations: finalOperations });
}

