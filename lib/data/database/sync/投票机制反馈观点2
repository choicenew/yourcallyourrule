JavaScript
// 文件: index.js (Cloudflare Worker)

// =============================================================================
// SECTION: PUSH HANDLER (POST /sync) - FINAL PROFESSIONAL VERSION
// =============================================================================
/**
 * (最终专业版) 处理客户端推送的数据变更 (POST /sync)
 *
 * 核心逻辑:
 * 1. 按 phoneNumber 对所有操作进行分组。
 * 2. 一次性批量读取所有涉及的 phoneNumber 的当前状态。
 * 3. 在内存中，为每个 phoneNumber 应用其所有待办操作 (投票、计数等)，计算出最终状态。
 * 4. 一次性批量写入所有 phoneNumber 的最终状态。
 * 5. 同时记录所有操作日志。
 *
 * 这个流程保证了高效性 (批量读写) 和原子性 (batch 执行)。
 */
async function handlePush(request, env) {
  const { operations, sourceDeviceId } = await request.json();
  if (!Array.isArray(operations) || !sourceDeviceId) {
    return errorResponse('Invalid request body.', 400);
  }
  if (operations.length === 0) {
    return jsonResponse({ success: true, message: 'No operations to process.' });
  }

  // --- 步骤 1: 按 phoneNumber 对操作进行分组 ---
  const opsByPhoneNumber = {};
  for (const op of operations) {
    // 使用 entityId，它在客户端被设置为 phoneNumber
    const phoneNumber = op.entityId;
    if (!phoneNumber) continue;
    if (!opsByPhoneNumber[phoneNumber]) {
      opsByPhoneNumber[phoneNumber] = [];
    }
    opsByPhoneNumber[phoneNumber].push(op);
  }

  const phoneNumbersToProcess = Object.keys(opsByPhoneNumber);
  if (phoneNumbersToProcess.length === 0) {
      return jsonResponse({ success: true, message: 'No valid operations to process.' });
  }

  // --- 步骤 2: 一次性批量读取所有相关记录的当前状态 ---
  const placeholders = phoneNumbersToProcess.map(() => '?').join(',');
  const readStmt = env.DB.prepare(
    `SELECT phoneNumber, id, name, label, priority, action, count FROM remote_numbers WHERE phoneNumber IN (${placeholders})`
  ).bind(...phoneNumbersToProcess);
  const { results: existingRecords } = await readStmt.all();
  
  // 将查询结果转换为一个 Map，以便快速查找
  const recordsMap = new Map(existingRecords.map(r => [r.phoneNumber, r]));

  // --- 步骤 3: 在内存中计算每个 phoneNumber 的最终状态 ---
  const finalUpsertStmts = []; // 用于最终写入 `remote_numbers` 的语句
  const logStmts = [];         // 用于写入 `op_log` 的语句

  for (const phoneNumber of phoneNumbersToProcess) {
    const ops = opsByPhoneNumber[phoneNumber];
    let currentRecord = recordsMap.get(phoneNumber);

    // 如果记录不存在，初始化一个基础结构
    if (!currentRecord) {
      currentRecord = {
        phoneNumber: phoneNumber,
        id: new Uuid().v4(), // 默认给一个UUID，但 payload 中的 id 优先
        name: null,
        label: '{}', // 初始为空 JSON
        priority: 0,
        action: 'none',
        count: 0
      };
    }
    
    // 从当前记录初始化计算变量
    let finalState = { ...currentRecord };
    let currentVotes = {};
    try {
        currentVotes = JSON.parse(finalState.label).votes || {};
    } catch(e) { /* ignore malformed json */ }

    // 应用该号码的所有待办操作
    for (const op of ops) {
      // 始终记录日志
      logStmts.push(
        env.DB.prepare('INSERT INTO op_log (log_id, phoneNumber, operation, payload, timestamp, source_device_id) VALUES (?, ?, ?, ?, ?, ?)')
          .bind(crypto.randomUUID(), phoneNumber, op.operation, JSON.stringify(op.payload), op.timestamp, sourceDeviceId)
      );

      const payload = op.payload;
      switch (op.operation) {
        case 'INSERT':
        case 'UPDATE':
          // 使用 payload 中的数据更新最终状态
          // 这会覆盖 name, priority, action 等字段
          finalState = { ...finalState, ...payload };
          break;
        
        case 'VOTE':
          if (payload && payload.labelVote) {
            const vote = payload.labelVote;
            currentVotes[vote] = (currentVotes[vote] || 0) + 1;
          }
          if (payload && payload.increment) {
             finalState.count += payload.increment;
          }
          break;

        case 'DELETE':
          // [安全措施] 删除操作只记录日志，不修改 finalState
          console.log(`Logged a DELETE intent from device ${sourceDeviceId} for ${phoneNumber}, but execution is DISABLED.`);
          break;
      }
    }

    // --- 在所有操作应用完毕后，计算最终的 label JSON ---
    let winner = '';
    if (Object.keys(currentVotes).length > 0) {
      winner = Object.entries(currentVotes).reduce((a, b) => a[1] > b[1] ? a : b)[0];
    }
    finalState.label = JSON.stringify({ votes: currentVotes, winner: winner });

    // --- 准备最终的 UPSERT (Insert or Update) 语句 ---
    finalUpsertStmts.push(
      env.DB.prepare(
        `INSERT INTO remote_numbers (phoneNumber, id, name, label, priority, action, count)
         VALUES (?, ?, ?, ?, ?, ?, ?)
         ON CONFLICT(phoneNumber) DO UPDATE SET
           id=excluded.id, name=excluded.name, label=excluded.label, priority=excluded.priority,
           action=excluded.action, count=excluded.count`
      ).bind(
        finalState.phoneNumber,
        finalState.id, // 使用 payload 中的 id (如果有) 或新生成的
        finalState.name,
        finalState.label, // 最终的 label JSON
        finalState.priority,
        finalState.action,
        finalState.count // 最终的 count
      )
    );
  }

  // --- 步骤 4: 一次性批量写入所有最终结果和日志 ---
  if (finalUpsertStmts.length > 0) {
    await env.DB.batch([...finalUpsertStmts, ...logStmts]);
  } else if (logStmts.length > 0) {
    // 即使没有数据变更（比如只有被禁用的DELETE操作），也需要记录日志
    await env.DB.batch(logStmts);
  }

  return jsonResponse({ success: true, processed: finalUpsertStmts.length });
}

高效的批量读取:
const { results: existingRecords } = await readStmt.all();
我们只执行了一次数据库查询，就获取了本次同步需要处理的所有号码的当前状态。这避免了在循环中反复查询数据库，性能极高。
