  static void registerCallListeners({
    required Function(String phoneNumber) onIncomingCall,
    required Function() onCallEnded,
  }) {
    callerIdChannel.setMethodCallHandler((call) async {
      print("CallHandler: Received method call: ${call.method}");
      switch (call.method) {
        case 'onIncomingCall':
          final String phoneNumber = call.arguments['phoneNumber'];
          print("CallHandler: Incoming call from $phoneNumber");
          onIncomingCall(phoneNumber);
          break;
        case 'onCallEnded':
          print("CallHandler: Call ended");
          onCallEnded();
          break;
        default:
          print("CallHandler: Unknown method ${call.method}");
      }
    });
  }





  static Future<void> endCurrentCall() async {
    try {
      await endCallChannel.invokeMethod('endCurrentCall');
    } on PlatformException catch (e) {
      print("Failed to end call: '${e.message}'.");
    }
  }
}

