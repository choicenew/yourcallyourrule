import 'dart:async';

import 'package:flutter/services.dart';

class PermissionHandler {
  static const MethodChannel _channel = MethodChannel('com.example.yourcallyourrule/permissions');
  static const MethodChannel _overlayChannel = MethodChannel('com.example.yourcallyourrule/overlay');
static const MethodChannel _defaultCallIdChannel = MethodChannel('com.example.yourcallyourrule/defaultCaller_id');
  static const MethodChannel _batteryOptimizationChannel = MethodChannel('com.example.yourcallyourrule/notification');
   static const MethodChannel _storageChannel = MethodChannel('com.example.yourcallyourrule/storage');
static Completer<void>? _channelReadyCompleter; 

  static Future<bool> requestSmsPermission() async {
    return await _channel.invokeMethod('requestSmsPermission');
  }

  static Future<bool> requestCallLogPermission() async {
    return await _channel.invokeMethod('requestCallLogPermission');
  }
  // Default Call ID permissions
Future<bool> isDefaultCallerIdApp() async {
  try {
    final bool isDefault = await _defaultCallIdChannel.invokeMethod('isDefaultCallerIdApp'); // 不需要 await
    return isDefault;
  } catch (e) {
    print('Error checking default caller ID app: $e');
    return false; // 或抛出异常，取决于你的错误处理策略
  }
}
  static Future<bool> requestPhoneStatePermission() async {
    return await _channel.invokeMethod('requestPhoneStatePermission');
  }

  static Future<bool> requestCallScreeningRole() async {
    return await _channel.invokeMethod('requestCallScreeningRole');
  }

  static Future<bool> requestNotificationPermission() async {
    return await _channel.invokeMethod('requestNotificationPermission');
  }
/*
  static Future<bool> requestOverlayPermission() async {
    return await _channel.invokeMethod('requestOverlayPermission');
  }*/
// Overlay permissions

  static Future<void> _ensureOverlayChannelReady() async {
    if (_channelReadyCompleter == null) {
      _channelReadyCompleter = Completer<void>();
      _overlayChannel.setMethodCallHandler((call) async {
        if (call.method == "onChannelReady") {
          _channelReadyCompleter!.complete();
        }
        return null;
      });
    }
    return _channelReadyCompleter!.future; 
  }

  static Future<bool> requestOverlayPermission() async {
    await _ensureOverlayChannelReady(); 
    final bool result = await _overlayChannel.invokeMethod('requestOverlayPermission');
    return result;
  }
  
  static Future<bool> requestContactPermission() async {
    return await _channel.invokeMethod('requestContactPermission');
  }

  static Future<bool> checkSmsPermission() async {
    return await _channel.invokeMethod('checkSmsPermission');
  }

  static Future<bool> checkCallLogPermission() async {
    return await _channel.invokeMethod('checkCallLogPermission');
  }

  static Future<bool> checkPhoneStatePermission() async {
    return await _channel.invokeMethod('checkPhoneStatePermission');
  }

  static Future<bool> checkNotificationPermission() async {
    return await _channel.invokeMethod('checkNotificationPermission');
  }

  static Future<bool> checkOverlayPermission() async {
    return await _channel.invokeMethod('checkOverlayPermission');
  }

  static Future<bool> checkContactPermission() async {
    return await _channel.invokeMethod('checkContactPermission');
  }

  static Future<void> listenPhoneState() async {
    await _channel.invokeMethod('listenPhoneState');
  }

  static Future<void> stopListenPhoneState() async {
    await _channel.invokeMethod('stopListenPhoneState');
  }
  // Storage permissions
  static Future<bool> requestStoragePermission() async {
    final bool result = await _storageChannel.invokeMethod('requestStoragePermission');
    return result;
  }

  static Future<bool> checkStoragePermission() async {
    final bool result = await _storageChannel.invokeMethod('checkStoragePermission');
    return result;
  }
    static Future<bool> requestBatteryOptimization() async {
    final bool result = await _batteryOptimizationChannel.invokeMethod('requestIgnoreBatteryOptimizations');
    return result;
  }

  static Future<bool> checkBatteryOptimization() async {
    final bool result = await _batteryOptimizationChannel.invokeMethod('isIgnoringBatteryOptimizations');
    return result;
  }
  // You might want to add a method to handle all permissions at once
  static Future<bool> requestAllPermissions() async {
    bool smsPermission = await requestSmsPermission();
    bool callLogPermission = await requestCallLogPermission();
    bool phoneStatePermission = await requestPhoneStatePermission();
    bool notificationPermission = await requestNotificationPermission();
    bool overlayPermission = await requestOverlayPermission();
    bool contactPermission = await requestContactPermission();

    return smsPermission && callLogPermission && phoneStatePermission &&
           notificationPermission && overlayPermission && contactPermission;
  }
}






