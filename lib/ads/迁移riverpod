import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:riverpod_annotation/riverpod_annotation.dart';

part 'ad_state.g.dart'; // 1. 添加 part 指令

// 2. 使用 @Riverpod 注解，并设置为 keepAlive
@Riverpod(keepAlive: true)
class AdState extends _$AdState { // 3. 继承自生成的 _$AdState
  
  // 4. 使用 build 方法返回初始状态
  @override
  bool build() {
    // 初始状态为广告启用
    return true;
  }

  // 获取当前广告状态 (这个 getter 可以保留，也可以移除，
  // 因为可以直接通过 ref.watch(adStateProvider) 获取 bool 值)
  bool get isAdEnabled => state;

  // 禁用广告
  void disableAds() {
    state = false;
  }

  // 启用广告
  void enableAds() {
    state = true;
  }
}

// 5. 移除旧的手动 Provider 定义
// final adStateProvider = StateNotifierProvider<AdState, bool>((ref) {
//   return AdState();
