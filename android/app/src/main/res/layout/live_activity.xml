<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/live_activity_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="1dp"
    android:background="@android:color/transparent">

    <!-- Avatar image -->
    <ImageView
        android:id="@+id/avatar_image"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentLeft="true"
        android:layout_marginEnd="8dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <!-- Call type icon (e.g., incoming/outgoing) -->
    <ImageView
        android:id="@+id/call_type_image"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentRight="true"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="8dp"
        android:contentDescription="@null"
        android:scaleType="centerInside" />

    <!-- Caller name -->
    <TextView
        android:id="@+id/caller_name_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/avatar_image"
        android:layout_toRightOf="@id/avatar_image"
        android:layout_alignTop="@id/avatar_image"
        android:layout_marginStart="8dp"
        android:textColor="#000000"
        android:textSize="16sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Caller number -->
    <TextView
        android:id="@+id/caller_number_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/avatar_image"
        android:layout_toRightOf="@id/avatar_image"
        android:layout_below="@id/caller_name_text"
        android:layout_marginStart="8dp"
        android:textColor="#666666"
        android:textSize="14sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Location -->
    <TextView
        android:id="@+id/location_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/avatar_image"
        android:layout_toRightOf="@id/avatar_image"
        android:layout_below="@id/caller_number_text"
        android:layout_marginStart="8dp"
        android:textColor="#666666"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Carrier -->
    <TextView
        android:id="@+id/carrier_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/avatar_image"
        android:layout_toRightOf="@id/avatar_image"
        android:layout_below="@id/location_text"
        android:layout_marginStart="8dp"
        android:textColor="#666666"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Country name -->
    <TextView
        android:id="@+id/country_name_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/avatar_image"
        android:layout_toRightOf="@id/avatar_image"
        android:layout_below="@id/carrier_text"
        android:layout_marginStart="8dp"
        android:textColor="#666666"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Labels -->
    <TextView
        android:id="@+id/labels_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/avatar_image"
        android:layout_toRightOf="@id/avatar_image"
        android:layout_below="@id/country_name_text"
        android:layout_marginStart="8dp"
        android:textColor="#666666"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Count -->
    <TextView
        android:id="@+id/count_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/avatar_image"
        android:layout_toRightOf="@id/avatar_image"
        android:layout_below="@id/labels_text"
        android:layout_marginStart="8dp"
        android:textColor="#666666"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Number type -->
    <TextView
        android:id="@+id/number_type_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/avatar_image"
        android:layout_toRightOf="@id/avatar_image"
        android:layout_below="@id/count_text"
        android:layout_marginStart="8dp"
        android:textColor="#666666"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- STIR/SHAKEN -->
    <TextView
        android:id="@+id/stir_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/avatar_image"
        android:layout_toRightOf="@id/avatar_image"
        android:layout_below="@id/number_type_text"
        android:layout_marginStart="8dp"
        android:textColor="#666666"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- SIM Card -->
    <TextView
        android:id="@+id/sim_card_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/avatar_image"
        android:layout_toRightOf="@id/avatar_image"
        android:layout_below="@id/stir_text"
        android:layout_marginStart="8dp"
        android:textColor="#666666"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Security message -->
    <TextView
        android:id="@+id/security_message_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/sim_card_text"
        android:layout_marginTop="8dp"
        android:textColor="#D32F2F"
        android:textSize="13sp"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- Optional progress bar (for future use) 
    <ProgressBar
        android:id="@+id/progress_bar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/security_message_text"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="0" />
-->
</RelativeLayout>