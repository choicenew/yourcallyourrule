<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_preview_card_bg_dark"
    android:padding="10dp">

    <!-- 顶栏：系统图标与防护战报标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_shield_radar" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:text="@string/overview"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_preview_pill_blue"
            android:paddingHorizontal="5dp"
            android:paddingVertical="2dp"
            android:text="@string/smart_caller_id"
            android:textColor="#3B82F6"
            android:textSize="7.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 中部：双栏 Bento 盒微缩 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_preview_item_bg"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:padding="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/total_blocked"
                android:textColor="#94A3B8"
                android:textSize="7sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12"
                android:textColor="#EF4444"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:background="@drawable/widget_preview_item_bg"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:padding="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SIM1 [8] · SIM2 [4]"
                android:textColor="#FFFFFF"
                android:textSize="7.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="14:00-16:00"
                android:textColor="#94A3B8"
                android:textSize="7sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 底栏：查看通话日志 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:background="@drawable/widget_preview_pill_blue"
        android:paddingHorizontal="6dp"
        android:paddingVertical="3dp"
        android:text="@string/clear_all_call_logs"
        android:textColor="#3B82F6"
        android:textSize="7.5sp"
        android:textStyle="bold" />
</LinearLayout>
