external class DateTime {
  constructor(year, [month, day, hour, minute, second, millisecond, microsecond])
  static function now()
  static function fromMillisecondsSinceEpoch(millisecondsSinceEpoch, {isUtc})
  static function fromMicrosecondsSinceEpoch(microsecondsSinceEpoch, {isUtc})
  static function utc(year, [month, day, hour, minute, second, millisecond, microsecond])
  static function parse(formattedString)

  get year
  get month
  get weekday
  get day
  get hour
  get minute
  get second
  get millisecond
  get microsecond
  get microsecondsSinceEpoch
  get millisecondsSinceEpoch
  get isUtc
  get timeZoneName
  get timeZoneOffset

  function add(duration)
  function subtract(duration)
  function compareTo(other)
  function difference(other)
  function isAfter(other)
  function isBefore(other)
  function isAtSameMomentAs(other)
  function toLocal()
  function toUtc()
  function toIso8601String()
  function toString()
}

external class Duration {
  constructor({days, hours, minutes, seconds, milliseconds, microseconds})
}
