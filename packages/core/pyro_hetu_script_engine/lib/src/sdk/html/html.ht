external class Html {
  static function parse(html)
}
external class Document {
  function querySelector(selector)
  function querySelectorAll(selector)
  get body
  get head
}
external class Element {
  function attr(name)
  function getAttribute(name)
  get text
  get innerHtml
  get outerHtml
  function querySelector(selector)
  function querySelectorAll(selector)
  get attributes
  get className
  get id
  get parent
  get children
}
