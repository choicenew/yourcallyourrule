name: pyro_ads_applovin
description: Standalone AppLovin MAX ad driver adapter for Pyro Ads Suite.
version: 1.0.0
publish_to: 'none'

environment:
  sdk: '>=3.5.0 <4.0.0'
  flutter: '>=3.10.0'

resolution: workspace

dependencies:
  flutter:
    sdk: flutter
  pyro_ads_protocol:
    path: ../pyro_ads_protocol
  applovin_max: ^4.6.4

  material_ui: any
dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^5.0.0
